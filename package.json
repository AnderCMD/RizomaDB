{
  "name": "rizomadb-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "build:brand": "node scripts/build-brand.mjs",
    "bench": "pnpm --filter @rizomadb/sql build && node packages/sql/bench/run.mjs",
    "audit:licenses": "node scripts/license-audit.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --prod --out sbom.cdx.json",
    "soak": "node --expose-gc scripts/soak.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "26.6.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}