{
  "name": "rizomadb",
  "displayName": "RizomaDB — Database Client",
  "description": "%description%",
  "version": "1.2.2",
  "repository": { "type": "git", "url": "https://github.com/AnderCMD/RizomaDB.git" },
  "bugs": { "url": "https://github.com/AnderCMD/RizomaDB/issues" },
  "homepage": "https://andercmd.github.io/RizomaDB/",
  "publisher": "AnderCMD",
  "license": "Apache-2.0",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "database",
    "sql",
    "postgres",
    "mysql",
    "sqlite",
    "mongodb",
    "redis",
    "client",
    "query"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace connection catalogs and policies are not loaded in untrusted workspaces."
    }
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "rizomadb.mcp",
        "label": "RizomaDB (read-only)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rizomadb",
          "title": "RizomaDB",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "rizomadb": [
        {
          "id": "rizomadb.connections",
          "name": "%view.connections%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rizomadb.connections",
        "contents": "%welcome%"
      }
    ],
    "commands": [
      {
        "command": "rizomadb.newConnection",
        "title": "%cmd.newConnection%",
        "category": "RizomaDB",
        "icon": "$(add)"
      },
      {
        "command": "rizomadb.newQuery",
