        "extensions": [
          ".redis"
        ],
        "configuration": "./syntaxes/redis-language-configuration.json"
      },
      {
        "id": "rizomadb-es",
        "aliases": [
          "RizomaDB Elasticsearch"
        ],
        "extensions": [
          ".esql",
          ".es"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      },
      {
        "id": "rizomadb-cypher",
        "aliases": [
          "RizomaDB Cypher"
        ],
        "extensions": [
          ".cypher",
          ".cyp"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rizomadb-mongo",
        "scopeName": "source.rizomadb-mongo",
        "path": "./syntaxes/mongo.tmLanguage.json"
      },
      {
        "language": "rizomadb-redis",
        "scopeName": "source.rizomadb-redis",
        "path": "./syntaxes/redis.tmLanguage.json"
      },
      {
        "language": "rizomadb-es",
        "scopeName": "source.rizomadb-es",
        "path": "./syntaxes/es.tmLanguage.json"
      },
      {
        "language": "rizomadb-cypher",
        "scopeName": "source.rizomadb-cypher",
        "path": "./syntaxes/cypher.tmLanguage.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "rizomadb.getStarted",
        "title": "%walk.title%",
        "description": "%walk.description%",
        "steps": [
          {
            "id": "connect",
            "title": "%walk.connect.title%",
            "description": "%walk.connect.desc%",
            "media": {
              "image": "media/icon.png",
              "altText": "RizomaDB"
            },
            "completionEvents": [
              "onCommand:rizomadb.newConnection"
            ]
          },
          {
            "id": "explore",
            "title": "%walk.explore.title%",
            "description": "%walk.explore.desc%",
            "media": {
              "image": "media/icon.png",
              "altText": "RizomaDB"
            },
            "completionEvents": [
