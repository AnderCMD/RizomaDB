    "menus": {
      "view/title": [
        {
          "command": "rizomadb.newConnection",
          "when": "view == rizomadb.connections",
          "group": "navigation"
        },
        {
          "command": "rizomadb.refresh",
          "when": "view == rizomadb.connections",
          "group": "navigation"
        },
        {
          "command": "rizomadb.importConnections",
          "when": "view == rizomadb.connections",
          "group": "navigation@3"
        },
        {
          "command": "rizomadb.openGuide",
          "when": "view == rizomadb.connections",
          "group": "navigation@5"
        },
        {
          "command": "rizomadb.openSettings",
          "when": "view == rizomadb.connections",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "rizomadb.newQuery",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "rizomadb.refresh",
          "when": "view == rizomadb.connections && (viewItem == connection || viewItem == schema || viewItem == category)",
          "group": "inline@2"
        },
        {
          "command": "rizomadb.openTable",
          "when": "view == rizomadb.connections && viewItem =~ /^table/",
          "group": "inline@1"
        },
        {
          "command": "rizomadb.newQuery",
          "when": "view == rizomadb.connections && viewItem == connection"
        },
        {
          "command": "rizomadb.toggleReadOnly",
          "when": "view == rizomadb.connections && viewItem == connection"
        },
        {
          "command": "rizomadb.readOnlyUser",
          "when": "view == rizomadb.connections && viewItem == connection"
        },
        {
          "command": "rizomadb.buildQuery",
          "when": "view == rizomadb.connections && viewItem == connection"
        },
        {
          "command": "rizomadb.disconnect",
          "when": "view == rizomadb.connections && viewItem == connection"
        },
        {
          "command": "rizomadb.deleteConnection",
          "when": "view == rizomadb.connections && viewItem == connection"
        },
        {
          "command": "rizomadb.openTable",
          "when": "view == rizomadb.connections && viewItem =~ /^table/"
        },
        {
          "command": "rizomadb.export",
          "when": "view == rizomadb.connections && viewItem =~ /^table/"
        },
        {
          "command": "rizomadb.showER",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "schema"
        },
        {
          "command": "rizomadb.designTable",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "schema"
        },
        {
          "command": "rizomadb.compareSchemas",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "schema"
        },
        {
          "command": "rizomadb.generateDocs",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "schema"
        },
        {
          "command": "rizomadb.suggestIndexes",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "schema"
        },
        {
          "command": "rizomadb.exportSchemaSnapshot",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "schema"
        },
        {
          "command": "rizomadb.showER",
          "when": "view == rizomadb.connections && viewItem =~ /^table/",
          "group": "schema"
        },
        {
          "command": "rizomadb.designTable",
          "when": "view == rizomadb.connections && viewItem =~ /^table/",
          "group": "schema"
        },
        {
          "command": "rizomadb.import",
          "when": "view == rizomadb.connections && viewItem =~ /^table/",
          "group": "data"
        },
        {
          "command": "rizomadb.compareData",
          "when": "view == rizomadb.connections && viewItem =~ /^table/",
          "group": "data"
        },
        {
          "command": "rizomadb.generateData",
          "when": "view == rizomadb.connections && viewItem =~ /^table/",
          "group": "data"
        },
        {
          "command": "rizomadb.backup",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "data"
        },
        {
          "command": "rizomadb.restore",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "data"
        },
        {
          "command": "rizomadb.mongo.analyzeSchema",
          "when": "view == rizomadb.connections && viewItem == table.mongodb",
          "group": "nosql"
        },
        {
          "command": "rizomadb.mongo.createIndex",
          "when": "view == rizomadb.connections && viewItem == table.mongodb",
          "group": "nosql"
        },
        {
          "command": "rizomadb.mongo.dropIndex",
          "when": "view == rizomadb.connections && viewItem == table.mongodb",
          "group": "nosql"
        },
        {
          "command": "rizomadb.redis.deleteKey",
          "when": "view == rizomadb.connections && viewItem == table.redis",
          "group": "nosql"
        },
        {
          "command": "rizomadb.redis.editValue",
          "when": "view == rizomadb.connections && viewItem == table.redis",
          "group": "nosql"
        },
        {
          "command": "rizomadb.redis.setTtl",
          "when": "view == rizomadb.connections && viewItem == table.redis",
          "group": "nosql"
        },
        {
          "command": "rizomadb.redis.renameKey",
          "when": "view == rizomadb.connections && viewItem == table.redis",
          "group": "nosql"
        },
        {
          "command": "rizomadb.admin",
          "when": "view == rizomadb.connections && viewItem == connection",
          "group": "admin"
        },
        {
          "command": "rizomadb.ai.describe",
          "when": "view == rizomadb.connections && viewItem == table",
          "group": "ai"
        }
      ],
      "editor/title": [
        {
          "command": "rizomadb.runQuery",
          "when": "editorLangId =~ /^(sql|rizomadb-mongo|rizomadb-redis|rizomadb-es|rizomadb-cypher)$/",
          "group": "navigation"
        },
        {
          "command": "rizomadb.cancelQuery",
          "when": "editorLangId =~ /^(sql|rizomadb-mongo|rizomadb-redis|rizomadb-es|rizomadb-cypher)$/ && rizomadb.running",
          "group": "navigation"
        },
        {
          "command": "rizomadb.explain",
          "when": "editorLangId =~ /^(sql|rizomadb-mongo|rizomadb-redis|rizomadb-es|rizomadb-cypher)$/",
          "group": "navigation@2"
        },
        {
          "command": "rizomadb.mongo.previewPipeline",
          "when": "editorLangId == rizomadb-mongo",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rizomadb.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorLangId =~ /^(sql|rizomadb-mongo|rizomadb-redis|rizomadb-es|rizomadb-cypher)$/ && editorTextFocus"
      },
      {
        "command": "rizomadb.runSelection",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId =~ /^(sql|rizomadb-mongo|rizomadb-redis|rizomadb-es|rizomadb-cypher)$/ && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "RizomaDB",
      "properties": {
        "rizomadb.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "es"
          ],
          "default": "auto",
          "description": "%cfg.language%"
        },
        "rizomadb.environments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,24}$"
              },
              "protection": {
                "type": "string",
                "enum": [
                  "none",
                  "confirm",
                  "readOnly"
                ],
                "default": "none"
              }
            }
          },
          "description": "%cfg.environments%"
        },
        "rizomadb.editor.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.codeLens%"
        },
        "rizomadb.editor.highlightStatement": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.highlightStatement%"
        },
        "rizomadb.explorer.groupByFamily": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.groupByFamily%"
        },
        "rizomadb.results.location": {
          "type": "string",
          "enum": [
            "bottom",
            "full",
            "beside"
          ],
          "default": "bottom",
          "description": "%cfg.resultsLocation%"
        },
        "rizomadb.security.confirmDestructive": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.confirmDestructive%"
        },
        "rizomadb.security.prodReadOnlyByDefault": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.prodReadOnly%"
        },
        "rizomadb.query.pageSize": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "markdownDescription": "%cfg.pageSize%"
        },
        "rizomadb.query.keysetPaging": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.keysetPaging%"
        },
        "rizomadb.query.maxRows": {
          "type": "number",
          "default": 100000,
          "minimum": 1,
          "markdownDescription": "%cfg.maxRows%"
        },
        "rizomadb.query.timeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%cfg.timeout%"
        },
        "rizomadb.history.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.historyEnabled%"
        },
        "rizomadb.history.retentionDays": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "markdownDescription": "%cfg.retention%"
        },
        "rizomadb.edit.applyImmediately": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.applyImmediately%"
        },
        "rizomadb.table.openRows": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "markdownDescription": "%cfg.openRows%"
        },
        "rizomadb.policy.team": {
          "type": "object",
          "default": {},
          "scope": "machine-overridable",
          "markdownDescription": "%cfg.policyTeam%"
        },
        "rizomadb.catalog.teamFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%cfg.catalogTeam%"
        },
        "rizomadb.audit.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.auditEnabled%"
        },
        "rizomadb.audit.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%cfg.auditPath%"
        },
        "rizomadb.audit.includeValues": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.auditValues%"
        },
        "rizomadb.mcp.autoRegister": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.mcpAutoRegister%"
        },
        "rizomadb.ai.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%cfg.aiEnabled%"
        },
        "rizomadb.ai.provider": {
          "type": "string",
          "enum": [
            "openai-compatible",
            "anthropic"
          ],
          "default": "openai-compatible",
          "markdownDescription": "%cfg.aiProvider%"
        },
        "rizomadb.ai.endpoint": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "markdownDescription": "%cfg.aiEndpoint%"
        },
        "rizomadb.ai.model": {
          "type": "string",
          "default": "llama3.1",
          "markdownDescription": "%cfg.aiModel%"
        },
        "rizomadb.ai.redactLiterals": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%cfg.aiRedact%"
        }
      }
    },
    "notebooks": [
      {
        "type": "rizomadb-sql-notebook",
